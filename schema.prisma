datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum PaymentMethod {
  COD
  CARD
}

enum PaymentStatus {
  UNPAID_COD
  PENDING_PAYMENT
  COMPLETED
  FAILED
  EXPIRED
}

enum OrderStatus {
  RESERVED
  CONFIRMED
  DELIVERED
  CANCELLED
  EXPIRED
}

enum Currency {
  USD
  PKR
  INR
  EUR
}

enum ProductStatus {
  DRAFT
  PUBLISHED
}

model Product {
  id              String          @id @default(uuid())
  sku             String          @unique
  title           String
  description     String?
  priceInCents    Int
  currency        Currency        @default(USD)
  imageUrl        String?
  category        String?
  status          ProductStatus   @default(DRAFT)
  stockQuantity   Int
  dropId          String?
  drop            DropRelease?    @relation(fields: [dropId], references: [id], onDelete: SetNull)
  dropOrder       Int             @default(0)
  holds           InventoryHold[]
  orders          Order[]
  reviews         ProductReview[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([dropId])
}

model DropRelease {
  id           String    @id @default(cuid())
  slug         String    @unique
  title        String
  tagline      String?
  startsAt     DateTime
  endsAt       DateTime
  isActive     Boolean   @default(true)
  sellAfterEnd Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]
}

model Order {
  id                  String          @id
  orderReference      String          @unique
  fullName            String
  email               String
  phone               String
  address             String
  city                String?
  country             String?
  size                String?
  productColor        String?
  productId           String?
  product             Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  productSku          String
  productTitle        String
  unitPriceInCents    Int
  quantity            Int
  totalAmountInCents  Int
  currency            Currency        @default(USD)
  paymentMethod       PaymentMethod
  paymentStatus       PaymentStatus   @default(PENDING_PAYMENT)
  orderStatus         OrderStatus     @default(RESERVED)
  stripeIntent        String?         @unique
  expiresAt           DateTime
  confirmedAt         DateTime?
  cancelledAt         DateTime?
  archivedAt          DateTime?       @db.Timestamptz(6)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  holds               InventoryHold[]

  @@index([paymentStatus])
  @@index([orderStatus])
  @@index([createdAt])
  @@index([stripeIntent])
}

model ProductReview {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  rating     Int
  body       String
  approved   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([productId, approved, createdAt])
}

model InventoryHold {
  id        String   @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  expiresAt DateTime
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([orderId, productId])
  @@index([expiresAt])
  @@index([productId])
  @@index([orderId])
}

model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model OwnerDevice {
  id        String   @id @default(cuid())
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(6)
}
