CREATE EXTENSION IF NOT EXISTS "uuid-ossp";

-- 1. CATEGORIES
CREATE TABLE IF NOT EXISTS categories (
category_id UUID DEFAULT uuid_generate_v4() PRIMARY KEY,
name TEXT NOT NULL UNIQUE,
slug TEXT NOT NULL UNIQUE,
description TEXT,
is_active BOOLEAN DEFAULT true,
created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- 2. PRODUCTS
CREATE TABLE IF NOT EXISTS products (
product_id UUID DEFAULT uuid_generate_v4() PRIMARY KEY,
category_id UUID REFERENCES categories(category_id) ON DELETE SET NULL,
name TEXT NOT NULL,
description TEXT,
price_pkr DECIMAL(10, 2) NOT NULL DEFAULT 0 CHECK (price_pkr >= 0),
price_usd DECIMAL(10, 2) NOT NULL DEFAULT 0 CHECK (price_usd >= 0),
stock_quantity INTEGER NOT NULL DEFAULT 0 CHECK (stock_quantity >= 0),
is_active BOOLEAN DEFAULT true,
is_limited_drop BOOLEAN DEFAULT false,
attributes JSONB DEFAULT '{}' CHECK (jsonb_typeof(attributes) = 'object'),
images JSONB DEFAULT '[]' CHECK (jsonb_typeof(images) = 'array'),
created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- 3. ORDERS
CREATE TABLE IF NOT EXISTS orders (
order_id UUID DEFAULT uuid_generate_v4() PRIMARY KEY,
customer_name TEXT NOT NULL,
customer_email TEXT CHECK (
customer_email IS NULL
OR customer_email ~* '^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+.[A-Za-z]{2,}$`'
),
customer_phone TEXT,
shipping_address TEXT NOT NULL,
country_code TEXT NOT NULL DEFAULT 'PK',
payment_method TEXT NOT NULL CHECK (payment_method IN ('COD', 'STRIPE')),
payment_status TEXT DEFAULT 'pending'
CHECK (payment_status IN ('pending','paid','failed','refunded')),
order_status TEXT DEFAULT 'pending'
CHECK (order_status IN ('pending','processing','shipped','delivered','cancelled','archived')),
total_pkr DECIMAL(10, 2) NOT NULL DEFAULT 0 CHECK (total_pkr >= 0),
total_usd DECIMAL(10, 2) NOT NULL DEFAULT 0 CHECK (total_usd >= 0),
stripe_payment_id TEXT,
created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- 4. ORDER ITEMS (Hardened Security Pipeline)
CREATE TABLE IF NOT EXISTS order_items (
item_id UUID DEFAULT uuid_generate_v4() PRIMARY KEY,
order_id UUID NOT NULL REFERENCES orders(order_id) ON DELETE CASCADE,
product_id UUID REFERENCES products(product_id) ON DELETE SET NULL,
product_name TEXT NOT NULL,
quantity INTEGER NOT NULL DEFAULT 1 CHECK (quantity > 0),
price_pkr DECIMAL(10, 2) NOT NULL DEFAULT 0 CHECK (price_pkr >= 0),
price_usd DECIMAL(10, 2) NOT NULL DEFAULT 0 CHECK (price_usd >= 0),
selected_attributes JSONB DEFAULT '{}' CHECK (jsonb_typeof(selected_attributes) = 'object')
);

-- 5. IDEMPOTENT PERFORMANCE INDEXES
CREATE INDEX IF NOT EXISTS idx_products_category ON products(category_id);
CREATE INDEX IF NOT EXISTS idx_orders_created_at ON orders(created_at DESC);
CREATE INDEX IF NOT EXISTS idx_order_items_order ON order_items(order_id);
CREATE INDEX IF NOT EXISTS idx_order_items_product ON order_items(product_id);
CREATE INDEX IF NOT EXISTS idx_orders_status ON orders(order_status);

-- Conditional Unique Index for Stripe Payments
CREATE UNIQUE INDEX IF NOT EXISTS idx_orders_stripe ON orders(stripe_payment_id) WHERE stripe_payment_id IS NOT NULL;

-- 6. SECURITY: HARDENED ROW LEVEL SECURITY (RLS) MIGRATION SAFE
ALTER TABLE categories ENABLE ROW LEVEL SECURITY;
ALTER TABLE products ENABLE ROW LEVEL SECURITY;
ALTER TABLE orders ENABLE ROW LEVEL SECURITY;
ALTER TABLE order_items ENABLE ROW LEVEL SECURITY;

-- Drop Existing Policies to Prevent Migration Errors
DROP POLICY IF EXISTS "Service role full access categories" ON categories;
DROP POLICY IF EXISTS "Service role full access products" ON products;
DROP POLICY IF EXISTS "Service role full access orders" ON orders;
DROP POLICY IF EXISTS "Service role full access order_items" ON order_items;
DROP POLICY IF EXISTS "Public read products" ON products;
DROP POLICY IF EXISTS "Public read categories" ON categories;
DROP POLICY IF EXISTS "Anyone can insert orders" ON orders;
DROP POLICY IF EXISTS "Anyone can insert order items" ON order_items;

-- Re-apply Hardened Service Role Master Policies
CREATE POLICY "Service role full access categories" ON categories FOR ALL USING (auth.role() = 'service_role') WITH CHECK (auth.role() = 'service_role');
CREATE POLICY "Service role full access products" ON products FOR ALL USING (auth.role() = 'service_role') WITH CHECK (auth.role() = 'service_role');
CREATE POLICY "Service role full access orders" ON orders FOR ALL USING (auth.role() = 'service_role') WITH CHECK (auth.role() = 'service_role');
CREATE POLICY "Service role full access order_items" ON order_items FOR ALL USING (auth.role() = 'service_role') WITH CHECK (auth.role() = 'service_role');

-- Re-apply Public Access Handlers (FIXED: Public Cannot Blindly Insert Into order_items Directly)
CREATE POLICY "Public read products" ON products FOR SELECT USING (is_active = true);
CREATE POLICY "Public read categories" ON categories FOR SELECT USING (is_active = true);
CREATE POLICY "Anyone can insert orders" ON orders FOR INSERT WITH CHECK (true);

-- 7. SYSTEM MANAGEMENT TRIGGERS
CREATE OR REPLACE FUNCTION update_updated_at() RETURNS TRIGGER AS `$
BEGIN
NEW.updated_at = NOW();
RETURN NEW;
END;
$$ LANGUAGE plpgsql;

DROP TRIGGER IF EXISTS trg_products_update ON products;
CREATE TRIGGER trg_products_update BEFORE UPDATE ON products FOR EACH ROW EXECUTE FUNCTION update_updated_at();

DROP TRIGGER IF EXISTS trg_orders_update ON orders;
CREATE TRIGGER trg_orders_update BEFORE UPDATE ON orders FOR EACH ROW EXECUTE FUNCTION update_updated_at();

